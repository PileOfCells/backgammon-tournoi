msgid "Suisse à deux vies avec bascule sur un tableau de seize"
msgstr "Suizo a dos vidas con paso a un cuadro de dieciséis"

#: ../../formats.md
msgid "Le plus court"
msgstr "Lo más corto"

#: ../../formats.md
msgid "Élimination simple"
msgstr "Eliminación directa"

#: ../../formats.md
msgid "Que personne ne parte après un seul match"
msgstr "Que nadie se vaya tras una sola partida"

#: ../../formats.md
msgid "Suisse à deux vies, ou principal + consolante"
msgstr "Suizo a dos vidas, o principal + consuelo"

#: ../../formats.md
msgid "Que chacun sache à l'avance son programme"
msgstr "Que cada uno conozca su programa de antemano"

#: ../../formats.md
msgid "Un petit champ, beaucoup de matchs"
msgstr "Un campo pequeño, muchas partidas"

#: ../../formats.md
msgid "Le champion doit être battu deux fois"
msgstr "Al campeón hay que batirlo dos veces"

#: ../../formats.md
msgid "Double élimination avec recharge"
msgstr "Doble eliminación con recarga"

